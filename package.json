{
  "name": "cabsathi",
  "private": true,
  "version": "0.1.0",
  "description": "CabSathi - share a cab with people going your way",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:seed": "npm run seed -w @cabsathi/api",
    "api": "npm run dev -w @cabsathi/api",
    "web": "npm run web -w @cabsathi/mobile",
    "app": "npm run start -w @cabsathi/mobile",
    "test": "npm test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "engines": {
    "node": ">=20"
  }
}
