PORT=4000
DATABASE_URL=postgres://cabsathi:cabsathi@localhost:5433/cabsathi
JWT_SECRET=change-me-local-only
# In dev mode no SMS is sent and the OTP is always 123456
OTP_DEV_MODE=true
# Mappls (MapmyIndia) static key: place search, routes, distance matrix. Tried before Google.
MAPPLS_REST_KEY=
# Google Maps Platform server key (Places API (New) + Routes API). Leave empty to use local stand-ins.
GOOGLE_MAPS_API_KEY=
# Optional own routing server (OSRM), used when there is no Google key, e.g. http://localhost:5000
OSRM_URL=
